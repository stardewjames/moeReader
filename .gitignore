# JVM crash/replay diagnostics contain local paths; never ship them.
/SuwayomiHost/hs_err_pid*.log
/SuwayomiHost/replay_pid*.log
/SuwayomiHost/javacore.*.txt
/SuwayomiHost/heapdump.*.phd
/SuwayomiHost/core.*.dmp

# Site-specific extension fixtures, live-host tests, and notes.
# These files may reference extension repositories or manga sites and must
# never be committed. Keep site names out of tracked source and docs.
/SiteTests/
/site-notes.local.md

# Local reference checkouts and reverse-engineering artifacts.
/.research/

# CircleCI local project binding (contains project identifiers; keep private).
/.circleci/info.yml

# All CircleCI local/project files stay private.
/.circleci/
