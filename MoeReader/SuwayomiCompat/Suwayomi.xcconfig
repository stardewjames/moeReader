// Build settings of the Suwayomi runtime backend (MoeReader/SuwayomiCompat).
//
// SuwayomiHost/jvm-ios/package.sh writes jvm.xcconfig with the link flags of
// the static HotSpot Zero VM (OpenJDK Mobile). Without it the app still
// builds; the backend then reports in Settings that this build does not
// include the runtime.
// Default for builds without a VM for the selected SDK. The generated file
// overrides this only for SDKs whose archives were packaged.
SUWAYOMI_JVM_DEAD_CODE_STRIPPING = YES
#include? "../../SuwayomiHost/build/runtime/ios/jvm.xcconfig"

// The JNI shim's module map (import SuwayomiJNI).
SWIFT_INCLUDE_PATHS = $(inherited) "$(PROJECT_DIR)/MoeReader/SuwayomiCompat/JNI/include"
OTHER_LDFLAGS = $(inherited) $(SUWAYOMI_JVM_LDFLAGS)
// The shim looks JNI_CreateJavaVM up at run time, so a linked VM must not be
// dead-stripped; builds without a VM keep the default.
DEAD_CODE_STRIPPING = $(SUWAYOMI_JVM_DEAD_CODE_STRIPPING)
