# Copies libj9jit29 into the image only when the VM build made one.
# java.base-copy lists the JIT library for every platform except linux_riscv64; the iOS builds
# configure OpenJ9 without the JIT (OMR_COMPILER=OFF) and would otherwise stop at a missing file.
#
# Tree: openj9-jdk21 (2e01e904eaf92c2c2f045763872432cc2053e8cf). Applied by apply-openj9-patches.sh.

diff --git a/closed/custom/modules/java.base/Copy.gmk b/closed/custom/modules/java.base/Copy.gmk
index 2240cc8db..a5f47b449 100644
--- a/closed/custom/modules/java.base/Copy.gmk
+++ b/closed/custom/modules/java.base/Copy.gmk
@@ -79,6 +79,10 @@ $(call openj9_copy_files_and_debuginfos, \
 # Target platforms without JIT support.
 NO_JIT_PLATFORMS := linux_riscv64
 TARGET_PLATFORM := $(OPENJDK_TARGET_OS)_$(OPENJDK_TARGET_CPU)
+# VM builds configured without the JIT (OMR_COMPILER=OFF, e.g. iOS) have no j9jit library.
+ifeq (,$(wildcard $(OPENJ9_VM_BUILD_DIR)/$(call SHARED_LIBRARY,j9jit29)))
+  NO_JIT_PLATFORMS += $(TARGET_PLATFORM)
+endif
 
 $(call openj9_copy_shlibs, \
 	j9dmp29 \
