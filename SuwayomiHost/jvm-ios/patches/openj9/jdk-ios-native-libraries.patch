# Builds the JDK's macOS native libraries (STATIC_LIBS) for iOS (TARGET_OS_IPHONE).
# - libjava java_props_macosx.c: iOS ObjC runtime headers; no SystemConfiguration (SCDynamicStore is
#   macOS-only), so system proxy settings are not mapped to Java properties on iOS.
# - libnet DefaultProxySelector.c: the CFNetwork proxy API from <CFNetwork/CFNetwork.h> (CoreServices
#   is macOS-only). NetworkInterface.c: <net/if_arp.h> is not in the iOS SDK (unused on Apple).
# - make: no libosxsecurity (Keychain API) and no libjli (launcher, Cocoa) in STATIC_LIBS builds.
#
# Tree: openj9-jdk21 (2e01e904eaf92c2c2f045763872432cc2053e8cf). Applied by apply-openj9-patches.sh.

diff --git a/make/modules/java.base/Lib.gmk b/make/modules/java.base/Lib.gmk
index d6429b588..297fde782 100644
--- a/make/modules/java.base/Lib.gmk
+++ b/make/modules/java.base/Lib.gmk
@@ -119,8 +119,10 @@ $(BUILD_LIBNIO): $(BUILD_LIBNET)
 
 ################################################################################
 # Create the macosx security library
+# (not for STATIC_LIBS: the static libraries are for embedding, e.g. on iOS, which has no Keychain
+# API for KeychainStore)
 
-ifeq ($(call isTargetOs, macosx), true)
+ifeq ($(call isTargetOs, macosx)+$(STATIC_LIBS), true+)
 
     $(eval $(call SetupJdkLibrary, BUILD_LIBOSXSECURITY, \
         NAME := osxsecurity, \
diff --git a/make/modules/java.base/lib/CoreLibraries.gmk b/make/modules/java.base/lib/CoreLibraries.gmk
index d931eff54..20e31496c 100644
--- a/make/modules/java.base/lib/CoreLibraries.gmk
+++ b/make/modules/java.base/lib/CoreLibraries.gmk
@@ -225,6 +225,9 @@ ifneq ($(USE_EXTERNAL_LIBZ), true)
       )
 endif
 
+# The launcher library has no use in STATIC_LIBS builds (embedded VMs, e.g. on iOS, which also
+# lacks the Cocoa framework it needs).
+ifneq ($(STATIC_LIBS), true)
 $(eval $(call SetupJdkLibrary, BUILD_LIBJLI, \
     NAME := jli, \
     OUTPUT_DIR := $(INSTALL_LIBRARIES_HERE), \
@@ -244,6 +247,7 @@ $(eval $(call SetupJdkLibrary, BUILD_LIBJLI, \
 ))
 
 TARGETS += $(BUILD_LIBJLI)
+endif # STATIC_LIBS
 
 LIBJLI_SRC_DIRS := $(call FindSrcDirsForComponent, java.base, libjli)
 
