# Builds OMR's macOS port and thread libraries for iOS (device and simulator, TARGET_OS_IPHONE).
# - port/osx/omrosdump.c: system (core) dumps need fork() and another task's Mach port/memory
#   (mach_vm.h is unsupported on iOS); omrdump_create reports them as unsupported instead.
# - port/unix/omrsysinfo.c: libproc is not in the iOS SDK; the open-file count, process list and
#   process name queries take their existing "not supported" paths.
# - include_core/thread_api.h: pthread_jit_write_protect_np() is unavailable on iOS, where nothing
#   is ever mapped executable (no MAP_JIT); omrthread_jit_write_protect_{enable,disable} are no-ops.
# - port/unix/omrcpu.c: omrcpu_flush_icache uses Apple's sys_icache_invalidate(); the iOS device
#   libSystem has no __clear_cache for __builtin___clear_cache (only the JIT flushes code anyway).
#
# Tree: omr (ebd02d9129dc06fa67a6f885f99a3926aa869154). Applied by apply-openj9-patches.sh.

diff --git a/include_core/thread_api.h b/include_core/thread_api.h
index 8517da3..5e30fc2 100644
--- a/include_core/thread_api.h
+++ b/include_core/thread_api.h
@@ -40,7 +40,11 @@
 #include "omrcomp.h"
 
 #if defined(OSX) && defined(AARCH64)
+#include <TargetConditionals.h>
+#if !TARGET_OS_IPHONE
+#define OMR_JIT_WRITE_PROTECT_NP
 #include <pthread.h> /* for pthread_jit_write_protect_np() */
+#endif /* !TARGET_OS_IPHONE */
 #endif /* defined(OSX) && defined(AARCH64) */
 
 #ifdef __cplusplus
@@ -1473,10 +1477,10 @@ struct J9ThreadLibrary;
  *
  * Currently only meaningful on macOS using Aarch64 processors.
  */
-#if defined(OSX) && defined(AARCH64)
+#if defined(OMR_JIT_WRITE_PROTECT_NP)
 #define omrthread_jit_write_protect_disable() pthread_jit_write_protect_np(0)
 #define omrthread_jit_write_protect_enable()  pthread_jit_write_protect_np(1)
-#else /* defined(OSX) && defined(AARCH64) */
+#else /* defined(OMR_JIT_WRITE_PROTECT_NP): iOS has no MAP_JIT memory to toggle */
 #define omrthread_jit_write_protect_disable() /* nop */
 #define omrthread_jit_write_protect_enable()  /* nop */
 #endif /* defined(OSX) && defined(AARCH64) */
diff --git a/port/osx/omrosdump.c b/port/osx/omrosdump.c
index cf90527..0e0d90c 100644
--- a/port/osx/omrosdump.c
+++ b/port/osx/omrosdump.c
@@ -26,6 +26,34 @@
  * @brief User space system dump for OSX
  */
 
+#include <TargetConditionals.h>
+#if TARGET_OS_IPHONE
+/* iOS has no fork() and no access to another task's port or memory (mach_vm), so the
+ * child-process core dump below cannot work: system dumps are reported as unsupported. */
+#include <stdio.h>
+#include "omrport.h"
+#include "omrportpriv.h"
+
+uintptr_t
+omrdump_create(struct OMRPortLibrary *portLibrary, char *filename, char *dumpType, void *userData)
+{
+	if (NULL != filename) {
+		snprintf(filename, EsMaxPath, "system dumps are not supported on iOS");
+	}
+	return 1;
+}
+
+int32_t
+omrdump_startup(struct OMRPortLibrary *portLibrary)
+{
+	return 0;
+}
+
+void
+omrdump_shutdown(struct OMRPortLibrary *portLibrary)
+{
+}
+#else /* TARGET_OS_IPHONE */
 #include <errno.h>
 #include <fcntl.h>
 #include <mach/mach.h>
@@ -711,3 +739,4 @@ void
 omrdump_shutdown(struct OMRPortLibrary *portLibrary)
 {
 }
+#endif /* TARGET_OS_IPHONE */
