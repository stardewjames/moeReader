# Lets configure --disable-warnings-as-errors-openj9 reach the JIT (macOS sanity build only).
# runtime/compiler forces -Werror on aarch64; Xcode 26+ clang flags omr/compiler/cs2/hashtab.h
# with -Wnontrivial-memcall and the build stops. The iOS builds never compile the JIT.
#
# Tree: openj9 (a1daf225f5cb0ccfb5d7309014701570435a94c4). Applied by apply-openj9-patches.sh.

diff --git a/runtime/compiler/CMakeLists.txt b/runtime/compiler/CMakeLists.txt
index ae3f6b5..4398f4f 100644
--- a/runtime/compiler/CMakeLists.txt
+++ b/runtime/compiler/CMakeLists.txt
@@ -347,7 +347,11 @@ omr_stringify(J9_CXXFLAGS_STR ${J9_SHAREDFLAGS} ${J9_CXXFLAGS})
 set(CMAKE_CXX_FLAGS "${J9_CXXFLAGS_STR}")
 set(CMAKE_C_FLAGS "${J9_CFLAGS_STR}")
 
-if(OMR_ARCH_AARCH64 OR (OMR_ARCH_POWER AND NOT OMR_TOOLCONFIG STREQUAL "xlc") OR OMR_ARCH_S390 OR OMR_ARCH_X86)
+if(DEFINED J9VM_WARNINGS_AS_ERRORS AND NOT J9VM_WARNINGS_AS_ERRORS)
+	# configure --disable-warnings-as-errors-openj9 (newer clang adds default-on warnings).
+	set(OMR_WARNINGS_AS_ERRORS OFF)
+	set(OMR_ENHANCED_WARNINGS OFF)
+elseif(OMR_ARCH_AARCH64 OR (OMR_ARCH_POWER AND NOT OMR_TOOLCONFIG STREQUAL "xlc") OR OMR_ARCH_S390 OR OMR_ARCH_X86)
 	set(OMR_WARNINGS_AS_ERRORS ON)
 	set(OMR_ENHANCED_WARNINGS OFF)
 else()
