# Disables libffi's CFI pseudo-ops for Apple targets.
# macOS/iOS aarch64 reuse the Linux preconf/xr64/fficonfig.h, which enables .cfi_* directives;
# the Xcode 26+ assembler rejects them in aarch64/sysv.S ("invalid CFI advance_loc expression").
# CFI only describes unwind info for two assembly stubs, so dropping it changes nothing at run time.
#
# Tree: openj9 (a1daf225f5cb0ccfb5d7309014701570435a94c4). Applied by apply-openj9-patches.sh.

diff --git a/runtime/libffi/preconf/xr64/fficonfig.h b/runtime/libffi/preconf/xr64/fficonfig.h
index 36d51ad..8aafe86 100644
--- a/runtime/libffi/preconf/xr64/fficonfig.h
+++ b/runtime/libffi/preconf/xr64/fficonfig.h
@@ -44,7 +44,11 @@
 /* #undef HAVE_AS_ASCII_PSEUDO_OP */
 
 /* Define if your assembler supports .cfi_* directives. */
+/* Apple's assembler (Xcode 26+) rejects libffi's aarch64 CFI expressions
+   ("invalid CFI advance_loc expression"); macOS/iOS reuse this Linux config. */
+#if !defined(__APPLE__)
 #define HAVE_AS_CFI_PSEUDO_OP 1
+#endif
 
 /* Define if your assembler supports .register. */
 /* #undef HAVE_AS_REGISTER_PSEUDO_OP */
