#!/usr/bin/env bash
# OMR_EXE_LAUNCHER for the OpenJ9 iOS cross builds. OMR and OpenJ9 run some of their own programs
# while building (hookgen, tracegen, tracemerge, constgen). In a cross build those programs are iOS
# (or iOS-simulator) arm64 executables, which macOS refuses to run. The CPU and the ABI are the
# same, so a copy retagged as macOS (vtool) runs natively. Dylibs the program loads by @rpath are
# copied and retagged as well. Struct layouts are the target's, which is what constgen needs.
#   run-ios-tool PROGRAM [ARGS...]
set -euo pipefail
exe="$1"; shift
tmp="$(mktemp -d "${TMPDIR:-/tmp}/run-ios-tool.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT

retag() { # src dst
  vtool -set-build-version macos 14.0 26.0 -replace -output "$2" "$1" >/dev/null 2>&1
  codesign -f -s - "$2" >/dev/null 2>&1
}

# Directories that @rpath may point at: the program's LC_RPATHs and its own directory.
exedir="$(cd "$(dirname "$exe")" && pwd)"
search=("$exedir")
while read -r rp; do
  rp="${rp/@loader_path/$exedir}"; rp="${rp/@executable_path/$exedir}"
  search+=("$rp")
done < <(otool -l "$exe" | awk '/cmd LC_RPATH/{f=1} f&&/ path /{print $2; f=0}')

copy_deps() { # binary
  local dep name dir
  for dep in $(otool -L "$1" | awk 'NR>1 && $1 ~ /^@rpath\//{print $1}'); do
    name="${dep#@rpath/}"
    [ -e "$tmp/$name" ] && continue
    for dir in "${search[@]}"; do
      if [ -f "$dir/$name" ]; then
        mkdir -p "$(dirname "$tmp/$name")"
        retag "$dir/$name" "$tmp/$name"
        copy_deps "$dir/$name"
        break
      fi
    done
  done
}

prog="$tmp/$(basename "$exe")"
retag "$exe" "$prog"
copy_deps "$exe"
install_name_tool -add_rpath "$tmp" "$prog" 2>/dev/null && codesign -f -s - "$prog" >/dev/null 2>&1 || true
set +e
DYLD_LIBRARY_PATH="$tmp${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}" "$prog" "$@"
status=$?
exit $status
